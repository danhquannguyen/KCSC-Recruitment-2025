static Weapon shop_weapons[SHOP_WEAPON_COUNT] = {
    { "Holy Sword Excalibur",      3000},
    { "Blue Rose Sword",           4500},
    { "Elucidator",                6000},
    { "Starship Metal Estoc",      8000},
    { "Lightning Hammer Mjolnir", 10000},
