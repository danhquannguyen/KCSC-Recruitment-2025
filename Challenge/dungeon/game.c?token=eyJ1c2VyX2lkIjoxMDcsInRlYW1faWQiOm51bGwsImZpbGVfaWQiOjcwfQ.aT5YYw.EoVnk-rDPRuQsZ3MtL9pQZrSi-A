    { "Illfang the Kobold Lord",    "Crimson Fang Barrage",    15000,  4000,  1500 },
    { "Asterius the Taurus King",   "Titan's Rampage",         22000,  5500,  2500 },
    { "Nerius the Evil Treant",     "Verdant Doom Vines",      30000,  7000,  3500 },
    { "Wythege the Hippocampus",    "Abyssal Tidal Roar",      38000,  8500,  4500 },
    { "Fuscus the Vacant Colossus", "Starfall Earthbreaker",   48000, 10000,  5500 },
    { "The Irrational Cube",        "Chaotic Dimension Crush", 60000, 12000,  6500 },
    { "Aghyellr the Igneous Wyrm",  "Magma Cataclysm",         75000, 14000,  8000 },
    { "Kagachi the Samurai Lord",   "Moonlit Iaido Dance",     95000, 17000, 10000 },
    { "The Storm Griffin",          "Tempest Sky Rend",       120000, 20000, 13000 },
    { "The Strict Hermit",          "Void Sermon",            150000, 24000, 16000 }
